  "id": "git-git-push-force-with-lease",
  "slug": "git-push-force-with-lease",
  "name": "git push --force-with-lease",
  "description": "Force-push only if the remote has not changed unexpectedly.",
  "explanation": "Overwrites remote history. Unlike --force it refuses if someone else pushed since your last fetch. Never use on shared branches such as main.",
  "category": "git",
  "syntax": "git push --force-with-lease [<remote> <branch>]",
  "examples": [
   {
    "command": "git push --force-with-lease origin feature/search",
    "description": "Safer force push after a rebase."
   }
  ],
