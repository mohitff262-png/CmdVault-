  "name": "git reset --soft HEAD~1",
  "description": "Undo the last commit but keep your changes staged.",
  "explanation": "--soft moves the branch pointer back one commit (HEAD~1) without touching the index or working tree. Do not use it on commits already pushed and shared unless you plan to force-push.",
