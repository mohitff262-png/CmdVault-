 {
  "id": "termux-termux-pkg-update",
  "slug": "termux-pkg-update",
  "name": "pkg update && pkg upgrade",
  "description": "Refresh package lists and upgrade Termux packages.",
  "explanation": "Run this first on a fresh install. Termux does not use sudo or apt in the usual rooted-Linux way; pkg wraps apt inside the Termux prefix.",
  "category": "termux",
  "syntax": "pkg update && pkg upgrade",
  "examples": [
   {
    "command": "pkg update && pkg upgrade -y",
    "description": "Update everything without prompts."
   }
  ],
  "platforms": [
   "termux"
  ],
  "tools": [
   "termux",
   "pkg"
  ],
  "difficulty": "beginner",
  "risk": "safe",
  "commonErrors": [
   {
    "message": "unable to locate package",
    "fix": "Run termux-change-repo to pick a working mirror, then pkg update again."
   }
  ],
  "keywords": [
