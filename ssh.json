 {
  "id": "ssh-scp",
  "slug": "scp",
  "name": "scp",
  "description": "Copy files over SSH.",
  "explanation": "scp uses uppercase -P for port (ssh uses lowercase -p). Existing files are overwritten silently.",
  "category": "ssh",
  "syntax": "scp [-P <port>] <src> <user>@<host>:<dest>",
  "examples": [
   {
    "command": "scp ./app.tar.gz deploy@203.0.113.10:/tmp/",
    "description": "Upload an archive."
   }
  ],
