  "id": "linux-find-port-process",
  "slug": "find-port-process",
  "name": "lsof -i :PORT",
  "description": "Find which process is listening on a port.",
  "explanation": "Lists processes with open network sockets on that port. On Linux, ss -ltnp is an alternative that is usually preinstalled. You may need elevated privileges to see other users' processes.",
  "category": "linux",
  "syntax": "lsof -i :<port>  |  ss -ltnp | grep :<port>",
  "examples": [
   {
    "command": "lsof -i :3000",
    "description": "Show the process using port 3000."
   }
  ],
  "platforms": [
   "linux",
   "macos"
  ],
  "tools": [
   "bash"
  ],
  "difficulty": "intermediate",
  "risk": "safe",
  "commonErrors": [
